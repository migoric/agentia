{
  "name": "@migor/cli",
  "version": "0.10.3",
  "description": "CLI for the Agentia framework: scaffold a project, generate a capability, and open a local trace inspector for runs.",
  "type": "module",
  "bin": {
    "agentia": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": "migoric/agentia",
  "homepage": "https://agentia-web.pages.dev",
  "bugs": {
    "url": "https://github.com/migoric/agentia/issues"
  },
  "license": "MIT",
  "keywords": [
    "agentia",
    "agent",
    "ai-agent",
    "ai-agent-framework",
    "cli",
    "cli-tool",
    "scaffold",
    "generator",
    "trace-viewer",
    "observability",
    "devtools",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.templates.json && node scripts/copy-assets.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "node ../../scripts/check-release.mjs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
