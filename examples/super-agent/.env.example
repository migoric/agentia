# 真跑（npm start）需要的凭证 —— 框架自己不读 env、不读 .env，是 src/main.ts 这个宿主读的。
# `npm run demo` 完全不需要这些（零网络）。

# 走缺省 Anthropic 端点时只填这个：
ANTHROPIC_API_KEY=

# 或走 OpenAI 兼容端点（DeepSeek / vLLM / Ollama…）：填这两个 + 模型名
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# AGENTIA_MODEL=deepseek-chat

PORT=3000

# 入口鉴权（不设 = 不鉴权，仅本地开发）
SUPERAGENT_TOKEN=

# 任务库。生产换成文件路径；`:memory:` = 进程重启即丢（本示例默认值）
SUPERAGENT_DB=:memory:

# 「主动巡检」的间隔（毫秒）。0 = 关闭
SUPERAGENT_EVENT_POLL_MS=0
