{
  // Biome 配置（lint + format 二合一，Rust 实现）。
  // 为什么选 Biome 而非 eslint+prettier：单工具、单配置、无插件生态负担 —— 对一个
  // 「零新增运行时依赖」的库来说，工具链也尽量收敛到一个二进制。
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.astro",
      "!**/package-lock.json",
      // `.astro` 与独立 `.svg` 资产不进 lint 面：
      // Biome 对 Astro 语法支持不全（会把确实用到的 frontmatter import 误报为未使用），
      // 独立 SVG 是静态资产而非源码。官网版式另有 tests/docs/website-css.test.ts 钉不变量。
      "!**/*.astro",
      "!**/*.svg",
      // Markdown / YAML 不是本仓的代码面：Biome 2.6 起会格式化它们，但全仓
      // 历史文档的排版是**快照/证据**，不该为了工具升级重排 80 个文件。
      // 需要检查文档的另有专用用例（tests/docs/**），不靠 Biome。
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    // 关掉 organizeImports：`src/index.ts` 的导出按层次（core→engine→runtime→…）人为分组，
    // 自动排序会打乱这份「这就是分层」的可读顺序。
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        // 代码大量以 `!` 断言不变量（构造后必被 init 赋值、查表必命中），是有意为之。
        "noNonNullAssertion": "off",
        // 少量位置字符串拼接比模板串更直观，不强制统一。
        "useTemplate": "off"
      },
      "complexity": {
        // 泛型约束里的 `{}` / `Function` 是刻意写法（如 Blackboard 声明合并锚点、回调签名）。
        "noBannedTypes": "off",
        // 该规则默认是 **info** 级，而 CI 的 `--error-on-warnings` 不管 info —— 不升到 warn
        // 就等于闸门在低一级别上留了一个洞（这条是 2026-09-20 收紧 lint 时查出来的）。
        "useLiteralKeys": "warn"
      },
      "suspicious": {
        // 边界适配层（模型响应解析、duck-typed 桥）用 any 是刻意的 —— 保留为警告而非错误。
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      // 脚手架模板：lint 照常（真文件化的意义所在），只关 formatter。
      // 生成物的字节是与存量项目/e2e 断言的兼容契约（逐字节零漂移），而 Biome 的
      // 排版与契约不一致（如 tsconfig 模板的多行数组来自 JSON.stringify 的既有输出）——
      // 模板文件的排版由「渲染产物逐字节对拍」守门，不由 formatter 重排。
      "includes": ["packages/cli/templates/**"],
      "formatter": { "enabled": false }
    }
  ]
}
